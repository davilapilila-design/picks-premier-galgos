[Unit]
Description=Timer: ventas de overoption (%i), cuatro veces al día

[Timer]
# Hora de España (la VM va en UTC). Las ventas crecen despacio: con 4 veces
# basta. La de las 23:50, para que el resumen diario de las 00:05 tenga las
# ventas de la noche (pedido por el dueño el 2026-11-05).
OnCalendar=*-*-* 00,08,16:10:00 Europe/Madrid
OnCalendar=*-*-* 23:50:00 Europe/Madrid
RandomizedDelaySec=5m
Persistent=true

[Install]
WantedBy=timers.target
