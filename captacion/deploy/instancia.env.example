# Plantilla de configuración de una instancia del bot ("prueba" o "real").
# En la VM se copia a /etc/premier-captacion/<instancia>.env (solo root,
# permisos 600) y se rellena allí. NUNCA se sube al repo con datos reales:
# el token da control total del bot.

# Token que da @BotFather al crear el bot.
CAPTACION_BOT_TOKEN=

# @usuario (sin la @) al que llevan los botones «Ya he apostado» y
# «Es mi primera vez»: Dronwhite (también en las pruebas).
CAPTACION_PERFIL=

# Id de Telegram (un número) de quien recibe avisos y resúmenes. Si no lo
# sabes, déjalo vacío, arranca el bot y escríbele /miid desde esa cuenta.
CAPTACION_PROPIETARIO_ID=

# Id del canal (empieza por -100). Si no lo sabes, déjalo vacío: cuando
# hagas administrador al bot en el canal, te enviará el id. Mientras esté
# vacío, el bot no acepta a nadie.
CAPTACION_CANAL_ID=

# Id del Google Sheet al que se copia todo (fase 2): lo que va entre /d/ y
# /edit en su enlace. Vacío = sin Sheet. El Sheet tiene que estar
# compartido como editor con la cuenta de servicio (lo dice instalar.sh).
CAPTACION_SHEET_ID=

# Copia diaria a Google Drive de lo que usa el cruce de ventas (copia-drive.sh):
# remoto de rclone (configurado para root) y carpeta, p. ej. gdrive:premier-captacion.
# Vacío = sin copia.
CAPTACION_COPIA_DRIVE=

# --- Lector de la cuenta de Telegram del dueño (fases 3 y 4) ---
# api_id y api_hash de my.telegram.org («API development tools»). El
# api_hash es secreto: se pone con  configurar.sh <instancia> api
CAPTACION_API_ID=
CAPTACION_API_HASH=
# 1 = simulación (solo avisa por el bot de lo que haría, sin tocar nada).
# 0 = actúa de verdad. Se cambia con  configurar.sh <instancia> lector real
CAPTACION_LECTOR_SIMULAR=1
# Opcionales (estos son los valores por defecto):
# CAPTACION_DIAS_CARPETAS=5
# CAPTACION_FREE_SEND=free send
# CAPTACION_MAX_FREE_SEND=90
# CAPTACION_MAX_CARPETAS=10
# CAPTACION_MAX_CHATS_CARPETA=100
